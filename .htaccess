# Nonaktifkan Directory Listing untuk keamanan
Options -Indexes

# Lindungi file sensitif dari akses langsung via browser
<FilesMatch "^(\.env|\.env\.example|\.gitignore|rule\.md|implementation_plan\.md|composer\.(json|lock)|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers dasar
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Routing Front Controller
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke folder internal
    RewriteRule ^(config|database|helpers|middlewares|models|views)/ - [F,L]

    # Teruskan request ke index.php jika bukan file atau direktori fisik
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

