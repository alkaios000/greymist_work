# ==========================================================
# TEMPLATE KONFIGURASI APLIKASI & ROUTE GREYMIST
# Salin file ini menjadi .env dan sesuaikan nilainya
# ==========================================================
APP_NAME=Greymist
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
BASE_URL=

# ==========================================================
# KREDENSIAL DATABASE MYSQL / MARIADB
# ==========================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=GREYMISTBETA
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ==========================================================
# KREDENSIAL AKUN ADMINISTRATOR UTAMA
# ==========================================================
ADMIN_NICKNAME="Greymist Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@greymist.com
ADMIN_PASSWORD=admin123

ADMIN_ALT_USERNAME=greymist
ADMIN_ALT_PASSWORD=admin123

# ==========================================================
# KREDENSIAL AKUN PENGGUNA DEFAULT
# ==========================================================
USER_NICKNAME=Nasuha
USER_USERNAME=nasuha
USER_EMAIL=nasuha@greymist.com
USER_PASSWORD=123456

# ==========================================================
# KONFIGURASI KEAMANAN, UPLOAD & GEMINI AI PLUGIN
# ==========================================================
MAX_UPLOAD_SIZE_MB=10
SESSION_LIFETIME=7200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
